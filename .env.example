# Copy to .env. Leave GEMINI_API_KEY blank to run entirely offline on the
# deterministic fallback engine (app/services/fallback_engine.py) -- useful
# for demos/CI without API costs. Set it to drive the swarm with real Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=postgresql+psycopg2://swarmshield:swarmshield@localhost:5432/swarmshield
