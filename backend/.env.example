ENV=development
DATABASE_URL=postgresql+psycopg2://swarmshield:swarmshield@localhost:5432/swarmshield
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# Local-first LLM routing. No model is downloaded automatically.
LLM_PROVIDER=auto
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=
LOCAL_LLM_BASE_URL=http://localhost:11434
GROK_ENABLED=false
GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1
LLM_CLOUD_FALLBACK=true
LLM_CONFIDENCE_THRESHOLD=0.80
LLM_MEDIUM_CONFIDENCE_THRESHOLD=0.60
LOCAL_LLM_MAX_CONTEXT_TOKENS=4000
LOCAL_LLM_MAX_OUTPUT_TOKENS=1000
MAX_LOCAL_LLM_CONCURRENCY=2
MAX_CLOUD_LLM_CONCURRENCY=1
MAX_LOCAL_LLM_CALLS_PER_SCAN=100
MAX_CLOUD_LLM_CALLS_PER_SCAN=5
MAX_CLOUD_LLM_CALLS_PER_MINUTE=5

# Local RAG and persistent memory
RAG_ENABLED=true
RAG_TOP_K=6
RAG_MAX_CONTEXT_TOKENS=3500
MAX_RAG_QUERIES_PER_SCAN=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_ENABLED=true
MEMORY_MIN_IMPORTANCE=0.60
LLM_CACHE_ENABLED=true
MAX_ATTACK_ATTEMPTS_PER_VECTOR=5
SCAN_TIMEOUT_SECONDS=600
N8N_WEBHOOK_URL=

# --- GitHub (optional; powers the auto-PR remediation workflow) ---
# Leave blank to run with the auto-PR feature disabled (endpoints return a
# clear "not configured" error instead of failing open or crashing).
# Use a fine-grained PAT scoped to Contents:write + Pull requests:write on
# GITHUB_REPO only -- never a broad classic token.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=main
